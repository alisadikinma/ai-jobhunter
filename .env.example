# Copy this file to .env (same directory) and fill in your own values.
# .env is git-ignored; .env.example is the only one committed.
#
#   cp .env.example .env
#
# Never share these values or commit .env — they are per-account secrets.

# Apify API token — used by /gaspol-jobhunter:discover to run the
# bebity/linkedin-jobs-scraper actor for LinkedIn search.
# Get yours at: https://console.apify.com/settings/integrations
# Optional: leave empty and discover skips LinkedIn.
APIFY_TOKEN=

# Firecrawl API key — used by /gaspol-jobhunter:discover for board
# search/scrape, plus /gaspol-jobhunter:tailor's JD lookup and
# /gaspol-jobhunter:outreach's contact discovery.
# Get yours at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
